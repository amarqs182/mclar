+static void hle_TryLockLwMutex(void) {
+    uint32_t workarea = psp_arg(0);
+    int32_t count = (int32_t)psp_arg(1);
+    psp_lwmutex *m = find_lwmutex(workarea);
+    if (!m) { psp_ret(SCE_KERNEL_ERROR_OK); return; }
+    if (count <= 0) count = 1;
+    uint32_t me = g_current ? g_current->uid : 0;
+    if (m->count > 0 && m->owner_uid != me) {
+        psp_ret(0x800201C5u);   /* SCE_KERNEL_ERROR_LWMUTEX_LOCKED */
