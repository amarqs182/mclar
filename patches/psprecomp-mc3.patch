+static void hle_TerminateDeleteThread(void) {
+    psp_thread *t = find_thread(psp_arg(0));
+    if (!t || t == g_current) { psp_ret(SCE_KERNEL_ERROR_ILLEGAL_THID); return; }
+    t->terminated = 1;
+    t->delete_after = 1;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_SysClock2USec(void) {
+    uint32_t clock_ptr = psp_arg(0);
+    uint32_t seconds_ptr = psp_arg(1);
+    uint32_t microseconds_ptr = psp_arg(2);
+    uint64_t us = (uint64_t)psp_read32(clock_ptr) |
+                  ((uint64_t)psp_read32(clock_ptr + 4) << 32);
+    if (seconds_ptr)      psp_write32(seconds_ptr,      (uint32_t)(us / 1000000ull));
+    if (microseconds_ptr) psp_write32(microseconds_ptr, (uint32_t)(us % 1000000ull));
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+/* ---- fixed-size pools (FPL) ---------------------------------------------- */
+
+#define MAX_FPLS 16
+typedef struct {
+    uint32_t uid, base, block_size, blocks, next_free;
+    int used;
+} psp_fpl;
+static psp_fpl g_fpl[MAX_FPLS];
+
+static psp_fpl *find_fpl(uint32_t uid) {
+    for (int i = 0; i < MAX_FPLS; i++)
+        if (g_fpl[i].used && g_fpl[i].uid == uid) return &g_fpl[i];
+    return NULL;
+}
+
+static void hle_CreateFpl(void) {
+    uint32_t block_size = psp_arg(3), blocks = psp_arg(4);
+    if (!block_size || !blocks) { psp_ret(SCE_KERNEL_ERROR_ILLEGAL_ATTR); return; }
+    uint32_t base = psp_sysmem_alloc(block_size * blocks, 0);
+    if (!base) { psp_ret(SCE_KERNEL_ERROR_NO_MEMORY); return; }
+    for (int i = 0; i < MAX_FPLS; i++) {
+        if (!g_fpl[i].used) {
+            g_fpl[i].used = 1;
+            g_fpl[i].uid = g_next_uid++;
+            g_fpl[i].base = base;
+            g_fpl[i].block_size = block_size;
+            g_fpl[i].blocks = blocks;
+            g_fpl[i].next_free = 0;
+            psp_ret(g_fpl[i].uid);
+            return;
+        }
+    }
+    psp_sysmem_release(base);
+    psp_ret(SCE_KERNEL_ERROR_NO_MEMORY);
+}
+
+static void hle_DeleteFpl(void) {
+    psp_fpl *f = find_fpl(psp_arg(0));
+    if (!f) { psp_ret(SCE_KERNEL_ERROR_UNKNOWN_UID); return; }
+    if (f->base) psp_sysmem_release(f->base);
+    f->used = 0;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_AllocateFpl(void) {
+    psp_fpl *f = find_fpl(psp_arg(0));
+    if (!f) { psp_ret(SCE_KERNEL_ERROR_UNKNOWN_UID); return; }
+    uint32_t outp = psp_arg(1);
+    if (!outp) { psp_ret(SCE_KERNEL_ERROR_ILLEGAL_ADDR); return; }
+    if (f->next_free >= f->blocks) { psp_ret(SCE_KERNEL_ERROR_NO_MEMORY); return; }
+    psp_write32(outp, f->base + f->next_free * f->block_size);
+    f->next_free++;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_FreeFpl(void) {
+    psp_fpl *f = find_fpl(psp_arg(0));
+    if (!f) { psp_ret(SCE_KERNEL_ERROR_UNKNOWN_UID); return; }
+    if (f->next_free > 0) f->next_free--;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+/* ---- lightweight mutexes (LwMutex) --------------------------------------- */
+
+#define MAX_LWMUTEX 64
+typedef struct {
+    uint32_t workarea, attr, owner_uid;
+    int32_t count;
+    int used;
+} psp_lwmutex;
+static psp_lwmutex g_lwmutex[MAX_LWMUTEX];
+
+static psp_lwmutex *find_lwmutex(uint32_t workarea) {
+    for (int i = 0; i < MAX_LWMUTEX; i++)
+        if (g_lwmutex[i].used && g_lwmutex[i].workarea == workarea) return &g_lwmutex[i];
+    return NULL;
+}
+
+static void hle_CreateLwMutex(void) {
+    uint32_t workarea = psp_arg(0), attr = psp_arg(2);
+    int32_t init_count = (int32_t)psp_arg(3);
+    for (int i = 0; i < MAX_LWMUTEX; i++) {
+        if (g_lwmutex[i].used && g_lwmutex[i].workarea == workarea) {
+            g_lwmutex[i].attr = attr;
+            g_lwmutex[i].count = init_count;
+            g_lwmutex[i].owner_uid = init_count > 0 && g_current ? g_current->uid : 0;
+            psp_ret(SCE_KERNEL_ERROR_OK);
+            return;
+        }
+    }
+    for (int i = 0; i < MAX_LWMUTEX; i++) {
+        if (!g_lwmutex[i].used) {
+            g_lwmutex[i].used = 1;
+            g_lwmutex[i].workarea = workarea;
+            g_lwmutex[i].attr = attr;
+            g_lwmutex[i].count = init_count;
+            g_lwmutex[i].owner_uid = init_count > 0 && g_current ? g_current->uid : 0;
+            psp_ret(SCE_KERNEL_ERROR_OK);
+            return;
+        }
+    }
+    psp_ret(SCE_KERNEL_ERROR_NO_MEMORY);
+}
+
+static void hle_DeleteLwMutex(void) {
+    psp_lwmutex *m = find_lwmutex(psp_arg(0));
+    if (m) m->used = 0;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_LockLwMutex(void) {
+    uint32_t workarea = psp_arg(0);
+    int32_t count = (int32_t)psp_arg(1);
+    psp_lwmutex *m = find_lwmutex(workarea);
+    if (!m) { psp_ret(SCE_KERNEL_ERROR_OK); return; }
+    if (count <= 0) count = 1;
+    uint32_t me = g_current ? g_current->uid : 0;
+    while (m->count > 0 && m->owner_uid != me) {
+        park_for(W_SEMA, TICK_US);
+        deliver_tick();
+    }
+    m->count += count;
+    m->owner_uid = me;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_TryLockLwMutex(void) {
+    uint32_t workarea = psp_arg(0);
+    int32_t count = (int32_t)psp_arg(1);
+    psp_lwmutex *m = find_lwmutex(workarea);
+    if (!m) { psp_ret(SCE_KERNEL_ERROR_OK); return; }
+    if (count <= 0) count = 1;
+    uint32_t me = g_current ? g_current->uid : 0;
+    if (m->count > 0 && m->owner_uid != me) {
+        psp_ret(0x800201C5u);
+        return;
+    }
+    m->count += count;
+    m->owner_uid = me;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_UnlockLwMutex(void) {
+    uint32_t workarea = psp_arg(0);
+    int32_t count = (int32_t)psp_arg(1);
+    psp_lwmutex *m = find_lwmutex(workarea);
+    if (!m) { psp_ret(SCE_KERNEL_ERROR_OK); return; }
+    if (count <= 0) count = 1;
+    m->count -= count;
+    if (m->count <= 0) {
+        m->count = 0;
+        m->owner_uid = 0;
+        wake_waiters(W_SEMA);
+    }
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static int g_dispatch_suspended = 0;
+static void hle_SuspendDispatchThread(void) {
+    int prev = g_dispatch_suspended ? 0 : 1;
+    g_dispatch_suspended = 1;
+    psp_ret((uint32_t)prev);
+}
+static void hle_ResumeDispatchThread(void) {
+    g_dispatch_suspended = (psp_arg(0) == 0) ? 1 : 0;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
