diff --git i/src/hle/iofilemgr.c w/src/hle/iofilemgr.c
index 0b81a4b..bc5b06a 100644
--- i/src/hle/iofilemgr.c
+++ w/src/hle/iofilemgr.c
@@ -424,8 +424,10 @@ static void hle_WaitAsync(void) {
 }
 
 static void hle_Devctl(void) {
-    uint32_t cmd    = psp_arg(1);
-    uint32_t indata = psp_arg(2);
+    uint32_t cmd     = psp_arg(1);
+    uint32_t indata  = psp_arg(2);
+    uint32_t outdata = psp_arg(4);
+    uint32_t outlen  = psp_arg(5);
     if (cmd == 0x02425818u && indata) { /* ms0: free space */
         uint32_t ptr = psp_read32(indata);
         if (ptr) {
@@ -435,6 +437,8 @@ static void hle_Devctl(void) {
             psp_write32(ptr + 12,   512u); /* sectorSize */
             psp_write32(ptr + 16,    64u); /* sectorCount (32 KB/cluster -> 1 GB free) */
         }
+    } else if (cmd == 0x02425823u && outdata && outlen >= 4) { /* ms0: medium inserted */
+        psp_write32(outdata, 1u);
     }
     psp_ret(SCE_KERNEL_ERROR_OK);
 }
diff --git i/src/hle/threadman.c w/src/hle/threadman.c
index b11d74e..10a9a49 100644
--- i/src/hle/threadman.c
+++ w/src/hle/threadman.c
@@ -551,7 +551,11 @@ void psp_threadman_reset(void) {
     g_handovers = 0;
     g_handovers_expired = 0;
     g_vtime_us = 0;
-    g_epoch_us = host_now_us();
+    /* PSP sceKernelGetSystemTime is a monotonic uptime counter starting at 0,
+     * not a Unix wall-clock epoch; large epoch values overflow 32-bit ms math
+     * and destroy float32 precision in game timers. */
+    g_epoch_us = 0;
+    (void)host_now_us;
 
 #if PSPRECOMP_REAL_THREADS
     /* The caller is running the module entry: it holds the CPU from here. */
