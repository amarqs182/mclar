diff --git c/src/hle/atrac_ffmpeg.c w/src/hle/atrac_ffmpeg.c
new file mode 100644
index 0000000..d699d9b
--- /dev/null
+++ w/src/hle/atrac_ffmpeg.c
@@ -0,0 +1,157 @@
+#include "atrac_ffmpeg.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#if PSPRECOMP_HAVE_FFMPEG
+
+#include <libavcodec/avcodec.h>
+#include <libavutil/avutil.h>
+#include <libavutil/channel_layout.h>
+
+struct psp_atrac_dec {
+    AVCodecContext *ctx;
+    AVPacket       *pkt;
+    AVFrame        *frame;
+};
+
+static int16_t clamp_s16_f32(float v) {
+    float s = v * 32767.0f;
+    if (s > 32767.0f) return 32767;
+    if (s < -32767.0f) return -32767;
+    return (int16_t)s;
+}
+
+psp_atrac_dec *psp_atrac_dec_open(int codec_tag, int sample_rate, int channels,
+                                  int block_align, const uint8_t *extradata,
+                                  int extradata_size) {
+    enum AVCodecID cid = AV_CODEC_ID_NONE;
+    if (codec_tag == 0x0270) cid = AV_CODEC_ID_ATRAC3;
+    else if (codec_tag == 0xFFFE) cid = AV_CODEC_ID_ATRAC3P;
+    else return NULL;
+
+    const AVCodec *codec = avcodec_find_decoder(cid);
+    if (!codec) return NULL;
+
+    AVCodecContext *ctx = avcodec_alloc_context3(codec);
+    if (!ctx) return NULL;
+
+    ctx->sample_rate = sample_rate > 0 ? sample_rate : 44100;
+    ctx->block_align = block_align;
+    av_channel_layout_default(&ctx->ch_layout, channels > 0 ? channels : 2);
+
+    if (extradata && extradata_size > 0) {
+        ctx->extradata = (uint8_t *)av_mallocz((size_t)extradata_size + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!ctx->extradata) {
+            avcodec_free_context(&ctx);
+            return NULL;
+        }
+        memcpy(ctx->extradata, extradata, (size_t)extradata_size);
+        ctx->extradata_size = extradata_size;
+    }
+
+    if (avcodec_open2(ctx, codec, NULL) < 0) {
+        avcodec_free_context(&ctx);
+        return NULL;
+    }
+
+    psp_atrac_dec *d = (psp_atrac_dec *)calloc(1, sizeof(*d));
+    if (!d) {
+        avcodec_free_context(&ctx);
+        return NULL;
+    }
+    d->ctx   = ctx;
+    d->pkt   = av_packet_alloc();
+    d->frame = av_frame_alloc();
+    if (!d->pkt || !d->frame) {
+        psp_atrac_dec_close(d);
+        return NULL;
+    }
+    return d;
+}
+
+int psp_atrac_dec_frame(psp_atrac_dec *d, const uint8_t *in_pkt, int in_bytes,
+                        int16_t *out_pcm, int max_samples, int out_channels) {
+    if (!d || !d->ctx || !in_pkt || in_bytes <= 0 || !out_pcm || max_samples <= 0)
+        return 0;
+
+    av_packet_unref(d->pkt);
+    if (av_new_packet(d->pkt, in_bytes) < 0)
+        return 0;
+    memcpy(d->pkt->data, in_pkt, (size_t)in_bytes);
+
+    if (avcodec_send_packet(d->ctx, d->pkt) < 0) {
+        av_packet_unref(d->pkt);
+        return 0;
+    }
+    av_packet_unref(d->pkt);
+
+    av_frame_unref(d->frame);
+    int rc = avcodec_receive_frame(d->ctx, d->frame);
+    if (rc < 0)
+        return 0;
+
+    int nb = d->frame->nb_samples;
+    if (nb > max_samples) nb = max_samples;
+    int src_ch = d->frame->ch_layout.nb_channels;
+    if (src_ch <= 0) src_ch = 1;
+    if (out_channels <= 0) out_channels = src_ch;
+
+    enum AVSampleFormat fmt = (enum AVSampleFormat)d->frame->format;
+    for (int i = 0; i < nb; i++) {
+        for (int c = 0; c < out_channels; c++) {
+            int sc = (c < src_ch) ? c : (src_ch - 1);
+            int16_t sample = 0;
+            if (fmt == AV_SAMPLE_FMT_FLTP) {
+                const float *p = (const float *)d->frame->extended_data[sc];
+                sample = clamp_s16_f32(p[i]);
+            } else if (fmt == AV_SAMPLE_FMT_FLT) {
+                const float *p = (const float *)d->frame->data[0];
+                sample = clamp_s16_f32(p[i * src_ch + sc]);
+            } else if (fmt == AV_SAMPLE_FMT_S16P) {
+                const int16_t *p = (const int16_t *)d->frame->extended_data[sc];
+                sample = p[i];
+            } else if (fmt == AV_SAMPLE_FMT_S16) {
+                const int16_t *p = (const int16_t *)d->frame->data[0];
+                sample = p[i * src_ch + sc];
+            }
+            out_pcm[i * out_channels + c] = sample;
+        }
+    }
+    av_frame_unref(d->frame);
+    return nb;
+}
+
+void psp_atrac_dec_flush(psp_atrac_dec *d) {
+    if (d && d->ctx) avcodec_flush_buffers(d->ctx);
+}
+
+void psp_atrac_dec_close(psp_atrac_dec *d) {
+    if (!d) return;
+    if (d->frame) av_frame_free(&d->frame);
+    if (d->pkt)   av_packet_free(&d->pkt);
+    if (d->ctx)   avcodec_free_context(&d->ctx);
+    free(d);
+}
+
+#else /* !PSPRECOMP_HAVE_FFMPEG */
+
+psp_atrac_dec *psp_atrac_dec_open(int codec_tag, int sample_rate, int channels,
+                                  int block_align, const uint8_t *extradata,
+                                  int extradata_size) {
+    (void)codec_tag; (void)sample_rate; (void)channels;
+    (void)block_align; (void)extradata; (void)extradata_size;
+    return NULL;
+}
+
+int psp_atrac_dec_frame(psp_atrac_dec *d, const uint8_t *in_pkt, int in_bytes,
+                        int16_t *out_pcm, int max_samples, int out_channels) {
+    (void)d; (void)in_pkt; (void)in_bytes;
+    (void)out_pcm; (void)max_samples; (void)out_channels;
+    return 0;
+}
+
+void psp_atrac_dec_flush(psp_atrac_dec *d) { (void)d; }
+void psp_atrac_dec_close(psp_atrac_dec *d) { (void)d; }
+
+#endif /* PSPRECOMP_HAVE_FFMPEG */
