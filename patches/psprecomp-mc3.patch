+}
+
+int psp_mpeg_has_pending_video(void) {
+    return (g_es_buf.len > 0 || g_video_flushing) ? 1 : 0;
+}
+
+void psp_mpeg_flush_video(void) {
+    if (!g_codec_ctx || g_video_flushing) return;
+    if (g_parser && g_pkt) {
+        uint8_t *out_data = NULL;
+        int      out_size = 0;
+        av_parser_parse2(g_parser, g_codec_ctx,
+                         &out_data, &out_size,
+                         NULL, 0,
