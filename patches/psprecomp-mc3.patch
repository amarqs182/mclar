+static int buf_append(byte_buf_t *b, const uint8_t *src, size_t n) {
+    if (n == 0) return 0;
+    if (b->len + n > b->cap) {
+        size_t new_cap = b->cap ? b->cap * 2 : 65536;
+        while (new_cap < b->len + n) new_cap *= 2;
+        uint8_t *p = (uint8_t *)realloc(b->data, new_cap + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!p) return -1;
+        b->data = p;
+        b->cap  = new_cap;
+    }
+    memcpy(b->data + b->len, src, n);
+    b->len += n;
+    memset(b->data + b->len, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    return 0;
+}
+
+static void buf_consume(byte_buf_t *b, size_t n) {
+    if (n == 0) return;
+    if (n >= b->len) {
+        b->len = 0;
+        if (b->data) memset(b->data, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+        return;
+    }
+    memmove(b->data, b->data + n, b->len - n);
+    b->len -= n;
+    memset(b->data + b->len, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+}
+
+static uint16_t be16(const uint8_t *p) {
+    return (uint16_t)(((uint16_t)p[0] << 8) | (uint16_t)p[1]);
+}
+
+static int64_t parse_pes_ts(const uint8_t *p) {
+    return (((int64_t)(p[0] & 0x0E) << 29) |
+            ((int64_t)p[1] << 22) |
+            ((int64_t)(p[2] & 0xFE) << 14) |
+            ((int64_t)p[3] << 7) |
+            ((int64_t)(p[4] >> 1)));
+}
+
+static void pts_q_push(pts_entry_t *q, int *r, int *w, uint64_t es_off, int64_t pts, int64_t dts) {
+    int next_w = (*w + 1) % PTS_Q_CAP;
+    if (next_w == *r) {
+        *r = (*r + 1) % PTS_Q_CAP;
+    }
+    q[*w].es_off = es_off;
+    q[*w].pts    = pts;
+    q[*w].dts    = dts;
+    *w = next_w;
+}
+
+/* Demux complete MPEG-PS packs/PES packets from g_ps_buf, appending
+ * 0xE0..0xEF video PES payloads into g_es_buf and 0xBD audio into g_audio_es_buf. */
+static void demux_ps_to_es(void) {
+    size_t pos = 0;
+    const uint8_t *d = g_ps_buf.data;
+    size_t len = g_ps_buf.len;
+
+    while (pos + 4 <= len) {
+        if (d[pos] != 0x00 || d[pos + 1] != 0x00 || d[pos + 2] != 0x01) {
+            pos++;
+            continue;
+        }
+
+        uint8_t sid = d[pos + 3];
+
+        if (sid == 0xB9) {
+            pos += 4;
+            continue;
+        }
+
+        if (sid == 0xBA) {
+            if (pos + 5 > len) break;
+            if ((d[pos + 4] & 0xC0) == 0x40) {
+                if (pos + 14 > len) break;
+                size_t stuff = (size_t)(d[pos + 13] & 0x07);
+                if (pos + 14 + stuff > len) break;
+                pos += 14 + stuff;
+            } else if ((d[pos + 4] & 0xF0) == 0x20) {
+                if (pos + 12 > len) break;
+                pos += 12;
+            } else {
+                pos += 4;
+            }
+            continue;
+        }
+
+        if (sid < 0xBB) {
+            pos += 4;
+            continue;
+        }
+
+        if (pos + 6 > len) break;
+        uint16_t pkt_len = be16(d + pos + 4);
+        size_t total = 6u + (size_t)pkt_len;
+
+        if (pkt_len == 0) {
+            size_t next = pos + 6;
+            int found = 0;
+            while (next + 4 <= len) {
+                if (d[next] == 0x00 && d[next + 1] == 0x00 &&
+                    d[next + 2] == 0x01 && d[next + 3] >= 0xB9) {
+                    found = 1;
+                    break;
+                }
+                next++;
+            }
+            if (!found) break;
+            total = next - pos;
+        } else {
+            if (pos + total > len) break;
+        }
+
+        if ((sid == 0xBD || (sid >= 0xE0 && sid <= 0xEF)) && total > 6) {
+            const uint8_t *pes = d + pos;
+            size_t hdr_end = 6;
+            int64_t pts = AV_NOPTS_VALUE;
+            int64_t dts = AV_NOPTS_VALUE;
+
+            if (total >= 9 && (pes[6] & 0xC0) == 0x80) {
+                uint8_t flags = pes[7];
+                hdr_end = 9u + (size_t)pes[8];
+                if ((flags & 0x80u) && 9u + 5u <= hdr_end && hdr_end <= total) {
+                    pts = parse_pes_ts(pes + 9);
+                }
+                if ((flags & 0xC0u) == 0xC0u && 9u + 10u <= hdr_end && hdr_end <= total) {
+                    dts = parse_pes_ts(pes + 14);
+                }
+            } else {
+                while (hdr_end < total && pes[hdr_end] == 0xFF) hdr_end++;
+                if (hdr_end < total && (pes[hdr_end] & 0xC0) == 0x40) hdr_end += 2;
+                if (hdr_end < total) {
+                    uint8_t pts_bits = pes[hdr_end] & 0xF0;
+                    if (pts_bits == 0x20)      hdr_end += 5;
+                    else if (pts_bits == 0x30) hdr_end += 10;
+                    else                       hdr_end += 1;
+                }
+            }
+
+            if (sid == 0xBD) {
+                if (hdr_end + 4 < total && (pes[hdr_end] & 0xF0) == 0x00) {
+                    size_t pay_len = total - (hdr_end + 4);
+                    if (pts >= 0) {
+                        pts_q_push(g_apts_q, &g_apts_r, &g_apts_w,
+                                   g_audio_es_written, pts, AV_NOPTS_VALUE);
+                    }
+                    if (buf_append(&g_audio_es_buf, pes + hdr_end + 4, pay_len) == 0) {
+                        g_audio_es_written += (uint64_t)pay_len;
+                    }
+                }
+            } else if (hdr_end < total) {
+                size_t pay_len = total - hdr_end;
+                if (pts >= 0) {
+                    pts_q_push(g_vpts_q, &g_vpts_r, &g_vpts_w,
+                               g_video_es_written, pts, dts);
+                }
+                if (buf_append(&g_es_buf, pes + hdr_end, pay_len) == 0) {
+                    g_video_es_written += (uint64_t)pay_len;
+                }
+            }
+        }
+
+        pos += total;
+    }
+
+    buf_consume(&g_ps_buf, pos);
+}
+
+static int ensure_decoder_init(void) {
+    if (!g_codec_ctx) {
+        av_log_set_level(AV_LOG_ERROR);
+        const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_H264);
+        if (!codec) return -1;
+        g_codec_ctx = avcodec_alloc_context3(codec);
+        if (!g_codec_ctx) return -1;
+        if (avcodec_open2(g_codec_ctx, codec, NULL) < 0) {
+            avcodec_free_context(&g_codec_ctx);
+            return -1;
+        }
+    }
+    if (!g_parser) {
+        g_parser = av_parser_init(AV_CODEC_ID_H264);
+        if (!g_parser) return -1;
+    }
+    if (!g_pkt) {
+        g_pkt = av_packet_alloc();
+        if (!g_pkt) return -1;
+    }
+    if (!g_frame) {
+        g_frame = av_frame_alloc();
+        if (!g_frame) return -1;
+    }
+    return 0;
+}
+
+static int write_decoded_frame(uint32_t guest_buf, int frame_width) {
+    if (g_frame->width <= 0 || g_frame->height <= 0) return -1;
+
+    g_sws_ctx = sws_getCachedContext(
+        g_sws_ctx,
+        g_frame->width, g_frame->height, (enum AVPixelFormat)g_frame->format,
+        PSP_MPEG_WIDTH, PSP_MPEG_HEIGHT, AV_PIX_FMT_RGBA,
+        SWS_BILINEAR, NULL, NULL, NULL);
+    if (!g_sws_ctx) return -1;
+
+    uint8_t *dst_slices[1] = { g_rgba_buf };
+    int      dst_strides[1] = { PSP_MPEG_WIDTH * 4 };
+    sws_scale(g_sws_ctx,
+              (const uint8_t * const *)g_frame->data,
+              g_frame->linesize,
+              0,
+              g_frame->height,
+              dst_slices,
+              dst_strides);
+
+    if (!guest_buf) return 1;
+
+    if (frame_width <= 0) frame_width = 512;
+    uint32_t row_bytes    = PSP_MPEG_WIDTH * 4u;
+    uint32_t stride_bytes = (uint32_t)frame_width * 4u;
+
+    for (int y = 0; y < PSP_MPEG_HEIGHT; y++) {
+        if (psp_mem_write_block(guest_buf + (uint32_t)y * stride_bytes,
+                                g_rgba_buf + (size_t)y * row_bytes,
+                                row_bytes) != 0) {
+            return -1;
+        }
+    }
+    return 1;
+}
+
+static void stage_video_frame_from_gframe(void) {
+    int64_t frame_pts = g_frame->pts;
+    if (frame_pts == AV_NOPTS_VALUE) {
+        frame_pts = (g_last_video_out_pts != AV_NOPTS_VALUE)
+                        ? (g_last_video_out_pts + 3003)
+                        : 90000;
+    }
+    g_last_video_out_pts = frame_pts;
+    g_staged_video_pts   = frame_pts;
+    g_staged_video_dts   = (frame_pts >= 3003) ? (frame_pts - 3003) : 0;
+    g_video_staged       = 1;
+}
+
+static int stage_next_video_frame_locked(void) {
+    if (g_video_staged) return 1;
+    if (ensure_decoder_init() != 0) return -1;
+
+    int ret = avcodec_receive_frame(g_codec_ctx, g_frame);
+    if (ret == 0) {
+        stage_video_frame_from_gframe();
+        return 1;
+    }
+    if (ret == AVERROR_EOF) {
+        g_video_flushing = 0;
+        return 0;
+    }
+    if (ret != AVERROR(EAGAIN)) {
+        return -1;
+    }
+    if (g_video_flushing) {
+        return 0;
+    }
+
+    while (g_es_buf.len > 0) {
+        int64_t in_pts = AV_NOPTS_VALUE;
+        int64_t in_dts = AV_NOPTS_VALUE;
+        while (g_vpts_r != g_vpts_w && g_vpts_q[g_vpts_r].es_off <= g_video_es_consumed) {
+            in_pts = g_vpts_q[g_vpts_r].pts;
+            in_dts = g_vpts_q[g_vpts_r].dts;
+            g_vpts_r = (g_vpts_r + 1) % PTS_Q_CAP;
+        }
+
+        size_t chunk = g_es_buf.len;
+        if (g_vpts_r != g_vpts_w && g_vpts_q[g_vpts_r].es_off > g_video_es_consumed) {
+            uint64_t dist = g_vpts_q[g_vpts_r].es_off - g_video_es_consumed;
+            if (dist < (uint64_t)chunk) chunk = (size_t)dist;
+        }
+
+        uint8_t *out_data = NULL;
+        int      out_size = 0;
+        int consumed = av_parser_parse2(
+            g_parser, g_codec_ctx,
+            &out_data, &out_size,
+            g_es_buf.data, (int)chunk,
+            in_pts, in_dts, (int64_t)g_video_es_consumed);
+        if (consumed < 0) return -1;
+        if (consumed == 0 && out_size == 0) break;
+
+        if (out_size > 0 && out_data) {
+            int64_t pkt_pts = g_parser->pts;
+            if (pkt_pts == AV_NOPTS_VALUE) {
+                pkt_pts = (g_last_video_in_pts != AV_NOPTS_VALUE)
+                              ? (g_last_video_in_pts + 3003)
+                              : 90000;
+            }
+            g_last_video_in_pts = pkt_pts;
+
+            g_pkt->data = out_data;
+            g_pkt->size = out_size;
+            g_pkt->pts  = pkt_pts;
+            g_pkt->dts  = (g_parser->dts != AV_NOPTS_VALUE) ? g_parser->dts : pkt_pts;
+
+            ret = avcodec_send_packet(g_codec_ctx, g_pkt);
+            if (ret == AVERROR(EAGAIN)) {
+                int r2 = avcodec_receive_frame(g_codec_ctx, g_frame);
+                if (r2 == 0) {
+                    avcodec_send_packet(g_codec_ctx, g_pkt);
+                }
+                g_pkt->data = NULL;
+                g_pkt->size = 0;
+                buf_consume(&g_es_buf, (size_t)consumed);
+                g_video_es_consumed += (uint64_t)consumed;
+                if (r2 == 0) {
+                    stage_video_frame_from_gframe();
+                    return 1;
+                }
+                if (r2 != AVERROR(EAGAIN) && r2 != AVERROR_EOF) {
+                    return -1;
+                }
+                continue;
+            }
+
+            g_pkt->data = NULL;
+            g_pkt->size = 0;
+            buf_consume(&g_es_buf, (size_t)consumed);
+            g_video_es_consumed += (uint64_t)consumed;
+
+            if (ret == AVERROR_INVALIDDATA) {
+                continue;
+            }
+            if (ret < 0) {
+                return -1;
+            }
+
+            ret = avcodec_receive_frame(g_codec_ctx, g_frame);
+            if (ret == 0) {
+                stage_video_frame_from_gframe();
+                return 1;
+            }
+            if (ret != AVERROR(EAGAIN) && ret != AVERROR_EOF) {
+                return -1;
+            }
+        } else {
+            buf_consume(&g_es_buf, (size_t)consumed);
+            g_video_es_consumed += (uint64_t)consumed;
+        }
+    }
+
+    return 0;
+}
+
+static int ensure_audio_decoder_init(int block_align) {
+    av_log_set_level(AV_LOG_ERROR);
+    if (g_audio_ctx && g_audio_block_align != block_align) {
+        avcodec_free_context(&g_audio_ctx);
+        g_audio_block_align = 0;
+    }
+    if (!g_audio_ctx) {
+        const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_ATRAC3P);
+        if (!codec) return -1;
+        g_audio_ctx = avcodec_alloc_context3(codec);
+        if (!g_audio_ctx) return -1;
+        av_channel_layout_default(&g_audio_ctx->ch_layout, 2);
+        g_audio_ctx->sample_rate = 44100;
+        g_audio_ctx->block_align = block_align;
+        if (avcodec_open2(g_audio_ctx, codec, NULL) < 0) {
+            avcodec_free_context(&g_audio_ctx);
+            return -1;
+        }
+        g_audio_block_align = block_align;
+    }
+    if (!g_audio_pkt) {
+        g_audio_pkt = av_packet_alloc();
+        if (!g_audio_pkt) return -1;
+    }
+    if (!g_audio_frame) {
+        g_audio_frame = av_frame_alloc();
+        if (!g_audio_frame) return -1;
+    }
+    return 0;
+}
+
+static int16_t float_to_s16(float v) {
+    float scaled = v * 32767.0f;
+    if (scaled >= 32767.0f) return 32767;
+    if (scaled <= -32768.0f) return -32768;
+    return (int16_t)scaled;
+}
+
+static int stage_next_audio_frame_locked(void) {
+    if (g_audio_staged) return 1;
+
+    while (g_audio_es_buf.len >= 8) {
+        if (g_audio_es_buf.data[0] != 0x0F || g_audio_es_buf.data[1] != 0xD0) {
+            size_t skip = 1;
+            while (skip + 1 < g_audio_es_buf.len &&
+                   (g_audio_es_buf.data[skip] != 0x0F || g_audio_es_buf.data[skip + 1] != 0xD0)) {
+                skip++;
+            }
+            buf_consume(&g_audio_es_buf, skip);
+            g_audio_es_consumed += (uint64_t)skip;
+            continue;
+        }
+
+        int payload_sz = ((((int)(g_audio_es_buf.data[2] & 0x03) << 8) |
+                           (int)g_audio_es_buf.data[3]) + 1) * 8;
+        int frame_sz = 8 + payload_sz;
+        if (g_audio_es_buf.len < (size_t)frame_sz) {
+            return 0;
+        }
+
+        uint64_t frame_off = g_audio_es_consumed;
+        int64_t popped_pts = AV_NOPTS_VALUE;
+        while (g_apts_r != g_apts_w && g_apts_q[g_apts_r].es_off <= frame_off) {
+            popped_pts = g_apts_q[g_apts_r].pts;
+            g_apts_r = (g_apts_r + 1) % PTS_Q_CAP;
+        }
+        if (popped_pts != AV_NOPTS_VALUE) {
+            if (g_audio_pts_base == AV_NOPTS_VALUE) {
+                g_audio_pts_base           = popped_pts;
+                g_audio_samples_since_base = 0;
+            } else {
+                int64_t pred = g_audio_pts_base +
+                               (g_audio_samples_since_base * 90000LL + 22050LL) / 44100LL;
+                if (llabs(popped_pts - pred) > 4500) {
+                    g_audio_pts_base           = popped_pts;
+                    g_audio_samples_since_base = 0;
+                }
+            }
+        }
+
+        if (ensure_audio_decoder_init(payload_sz) != 0) {
+            return -1;
+        }
+
+        g_audio_pkt->data = g_audio_es_buf.data + 8;
+        g_audio_pkt->size = payload_sz;
+        int ret = avcodec_send_packet(g_audio_ctx, g_audio_pkt);
+        g_audio_pkt->data = NULL;
+        g_audio_pkt->size = 0;
+        buf_consume(&g_audio_es_buf, (size_t)frame_sz);
+        g_audio_es_consumed += (uint64_t)frame_sz;
+
+        if (ret < 0 && ret != AVERROR(EAGAIN)) {
+            if (ret == AVERROR_INVALIDDATA) continue;
+            return -1;
+        }
+
+        ret = avcodec_receive_frame(g_audio_ctx, g_audio_frame);
+        if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) {
+            continue;
+        }
+        if (ret < 0) {
+            return -1;
+        }
+
+        int n = g_audio_frame->nb_samples;
+        if (n > PSP_MPEG_AUDIO_SAMPS) n = PSP_MPEG_AUDIO_SAMPS;
+        memset(g_pcm_buf, 0, sizeof(g_pcm_buf));
+
+        if (g_audio_frame->format == AV_SAMPLE_FMT_FLTP) {
+            const float *l = (const float *)g_audio_frame->data[0];
+            const float *r = (g_audio_frame->ch_layout.nb_channels > 1 && g_audio_frame->data[1])
+                                 ? (const float *)g_audio_frame->data[1]
+                                 : l;
+            for (int i = 0; i < n; i++) {
+                g_pcm_buf[i * 2 + 0] = float_to_s16(l[i]);
+                g_pcm_buf[i * 2 + 1] = float_to_s16(r[i]);
+            }
+        } else if (g_audio_frame->format == AV_SAMPLE_FMT_S16) {
+            memcpy(g_pcm_buf, g_audio_frame->data[0], (size_t)n * 4u);
+        }
+
+        int64_t pts = (g_audio_pts_base != AV_NOPTS_VALUE)
+                          ? (g_audio_pts_base +
+                             (g_audio_samples_since_base * 90000LL + 22050LL) / 44100LL)
+                          : 90000;
+        g_audio_samples_since_base += n;
+        g_staged_audio_pts = pts;
+        g_audio_staged     = 1;
+        return 1;
+    }
+    return 0;
+}
+
+void psp_mpeg_reset(void) {
+    pthread_mutex_lock(&g_mpeg_mutex);
+    g_ps_buf.len = 0;
+    g_es_buf.len = 0;
+    g_audio_es_buf.len = 0;
+    g_vpts_r = g_vpts_w = 0;
+    g_apts_r = g_apts_w = 0;
+    g_video_es_written  = 0;
+    g_video_es_consumed = 0;
+    g_audio_es_written  = 0;
+    g_audio_es_consumed = 0;
+    g_video_flushing     = 0;
+    g_video_staged       = 0;
+    g_staged_video_pts   = 90000;
+    g_staged_video_dts   = 86997;
+    g_last_video_in_pts  = AV_NOPTS_VALUE;
+    g_last_video_out_pts = AV_NOPTS_VALUE;
+    g_audio_staged             = 0;
+    g_staged_audio_pts         = 90000;
+    g_audio_pts_base           = AV_NOPTS_VALUE;
+    g_audio_samples_since_base = 0;
+    if (g_codec_ctx) {
+        avcodec_flush_buffers(g_codec_ctx);
+    }
+    if (g_parser) {
+        av_parser_close(g_parser);
+        g_parser = NULL;
+    }
+    if (g_audio_ctx) {
+        avcodec_free_context(&g_audio_ctx);
+        g_audio_block_align = 0;
+    }
+    pthread_mutex_unlock(&g_mpeg_mutex);
+}
+
+void psp_mpeg_feed_ps(const uint8_t *data, int bytes) {
+    if (!data || bytes <= 0) return;
+    pthread_mutex_lock(&g_mpeg_mutex);
+    if (buf_append(&g_ps_buf, data, (size_t)bytes) == 0) {
+        demux_ps_to_es();
+    }
+    pthread_mutex_unlock(&g_mpeg_mutex);
+}
+
+int psp_mpeg_get_avc_au(int64_t *out_pts, int64_t *out_dts) {
+    pthread_mutex_lock(&g_mpeg_mutex);
+    int r = stage_next_video_frame_locked();
+    if (r > 0) {
+        if (out_pts) *out_pts = g_staged_video_pts;
+        if (out_dts) *out_dts = g_staged_video_dts;
+    }
+    pthread_mutex_unlock(&g_mpeg_mutex);
+    return (r > 0) ? 1 : r;
+}
+
+int psp_mpeg_decode_next_frame(uint32_t guest_buf, int frame_width) {
+    pthread_mutex_lock(&g_mpeg_mutex);
+    int r = g_video_staged ? 1 : stage_next_video_frame_locked();
+    if (r > 0 && g_video_staged) {
+        r = write_decoded_frame(guest_buf, frame_width);
+        g_video_staged = 0;
+    }
+    pthread_mutex_unlock(&g_mpeg_mutex);
+    return r;
+}
+
+int psp_mpeg_get_atrac_au(int64_t *out_pts) {
+    pthread_mutex_lock(&g_mpeg_mutex);
+    int r = stage_next_audio_frame_locked();
+    if (r > 0 && out_pts) {
+        *out_pts = g_staged_audio_pts;
+    }
+    pthread_mutex_unlock(&g_mpeg_mutex);
+    return (r > 0) ? 1 : r;
+}
+
+int psp_mpeg_decode_audio_frame(uint32_t guest_pcm_buf) {
+    pthread_mutex_lock(&g_mpeg_mutex);
+    int r = g_audio_staged ? 1 : stage_next_audio_frame_locked();
+    if (r > 0 && g_audio_staged) {
+        if (guest_pcm_buf) {
+            if (psp_mem_write_block(guest_pcm_buf, g_pcm_buf, PSP_MPEG_AUDIO_SAMPS * 4u) != 0) {
+                pthread_mutex_unlock(&g_mpeg_mutex);
+                return -1;
+            }
+        }
+        g_audio_staged = 0;
+        r = 1;
+    }
+    pthread_mutex_unlock(&g_mpeg_mutex);
+    return r;
+}
+
+int psp_mpeg_buffered_es_bytes(void) {
+    pthread_mutex_lock(&g_mpeg_mutex);
+    int len = (int)g_es_buf.len;
+    pthread_mutex_unlock(&g_mpeg_mutex);
+    return len;
+}
+
+int psp_mpeg_buffered_audio_bytes(void) {
+    pthread_mutex_lock(&g_mpeg_mutex);
+    int len = (int)g_audio_es_buf.len;
+    pthread_mutex_unlock(&g_mpeg_mutex);
+    return len;
+}
+
+int psp_mpeg_buffered_packets(void) {
+    pthread_mutex_lock(&g_mpeg_mutex);
+    size_t bytes = g_ps_buf.len + g_es_buf.len + g_audio_es_buf.len;
