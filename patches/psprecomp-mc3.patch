+ * Returns 1 if a frame was decoded, 0 if more data is needed, -1 on error. */
+int psp_mpeg_decode_audio_frame(uint32_t guest_pcm_buf);
+
+/* Return the number of elementary stream (H.264 ES) bytes currently buffered. */
+int psp_mpeg_buffered_es_bytes(void);
+
+/* Return the number of ATRAC3+ audio ES bytes currently buffered. */
+int psp_mpeg_buffered_audio_bytes(void);
+
+/* Return 1 if video ES or flushed decoder frames remain pending, 0 otherwise. */
+int psp_mpeg_has_pending_video(void);
+
+/* Flush the H.264 parser and send EOS to the video decoder so trailing frames drain. */
+void psp_mpeg_flush_video(void);
+
+/* Return 1 if at least one complete 0x0F 0xD0 ATRAC3+ frame is buffered, 0 otherwise. */
+int psp_mpeg_has_pending_audio(void);
+
+#ifdef __cplusplus
+}
+#endif
