+/* ---- fixed-size pools (FPL) ---------------------------------------------- */
+
+#define MAX_FPLS 16
+
+typedef struct {
+    uint32_t uid;
+    uint32_t base;
+    uint32_t block_size;
+    uint32_t blocks;
+    uint32_t next_free;
+    int      used;
+} psp_fpl;
+
+static psp_fpl g_fpl[MAX_FPLS];
+
+static psp_fpl *find_fpl(uint32_t uid) {
+    for (int i = 0; i < MAX_FPLS; i++)
+        if (g_fpl[i].used && g_fpl[i].uid == uid) return &g_fpl[i];
+    return NULL;
+}
+
+static void hle_CreateFpl(void) {
+    /* (name, part, attr, blocksize, blocks, option) */
+    uint32_t block_size = psp_arg(3);
+    uint32_t blocks     = psp_arg(4);
+    if (!block_size || !blocks) { psp_ret(SCE_KERNEL_ERROR_ILLEGAL_ATTR); return; }
+    uint32_t total = block_size * blocks;
+    uint32_t base = psp_sysmem_alloc(total, 0);
+    if (!base) { psp_ret(SCE_KERNEL_ERROR_NO_MEMORY); return; }
+
+    for (int i = 0; i < MAX_FPLS; i++) {
+        if (!g_fpl[i].used) {
+            g_fpl[i].used       = 1;
+            g_fpl[i].uid        = g_next_uid++;
+            g_fpl[i].base       = base;
+            g_fpl[i].block_size = block_size;
+            g_fpl[i].blocks     = blocks;
+            g_fpl[i].next_free  = 0;
+            psp_ret(g_fpl[i].uid);
+            return;
+        }
+    }
+    psp_sysmem_release(base);
+    psp_ret(SCE_KERNEL_ERROR_NO_MEMORY);
+}
+
+static void hle_DeleteFpl(void) {
+    psp_fpl *f = find_fpl(psp_arg(0));
+    if (!f) { psp_ret(SCE_KERNEL_ERROR_UNKNOWN_UID); return; }
+    if (f->base) psp_sysmem_release(f->base);
+    f->used = 0;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_AllocateFpl(void) {
+    /* (uid, void **addr, unsigned *timeout) */
+    psp_fpl *f = find_fpl(psp_arg(0));
+    if (!f) { psp_ret(SCE_KERNEL_ERROR_UNKNOWN_UID); return; }
+    uint32_t outp = psp_arg(1);
+    if (!outp) { psp_ret(SCE_KERNEL_ERROR_ILLEGAL_ADDR); return; }
+    if (f->next_free >= f->blocks) { psp_ret(SCE_KERNEL_ERROR_NO_MEMORY); return; }
+    uint32_t addr = f->base + f->next_free * f->block_size;
+    f->next_free++;
+    psp_write32(outp, addr);
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_FreeFpl(void) {
+    psp_fpl *f = find_fpl(psp_arg(0));
+    if (!f) { psp_ret(SCE_KERNEL_ERROR_UNKNOWN_UID); return; }
+    if (f->next_free > 0) f->next_free--;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
