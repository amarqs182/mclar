+static void hle_MpegRingbufferQueryMemSize(void) {
+    int32_t packets = (int32_t)psp_arg(0);
+    psp_ret((uint32_t)((packets > 0 ? packets : 1) * 2048));
+}
+static void hle_MpegQueryMemSize(void) { psp_ret(0x10000u); }
+static uint32_t g_mpeg_rb = 0;
+
+static void hle_MpegRingbufferConstruct(void) {
+    uint32_t rb = psp_arg(0);
+    int32_t packets = (int32_t)psp_arg(1);
+    uint32_t data = psp_arg(2);
+    uint32_t cb = psp_arg(4);
+    uint32_t cb_param = psp_arg(5);
+    g_mpeg_rb = rb;
+    if (rb) {
+        for (uint32_t i = 0; i < 44; i += 4) psp_write32(rb + i, 0);
+        psp_write32(rb + 0, (uint32_t)packets);
+        psp_write32(rb + 12, (uint32_t)packets);
+        psp_write32(rb + 16, 2048u);
+        psp_write32(rb + 20, data);
+        psp_write32(rb + 24, cb);
+        psp_write32(rb + 28, cb_param);
+        psp_write32(rb + 32, data + (uint32_t)packets * 2048u);
+    }
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+static void hle_MpegCreate(void) {
+    uint32_t mpeg = psp_arg(0);
+    uint32_t data = psp_arg(1);
+    uint32_t rb   = psp_arg(3);
+    if (rb) g_mpeg_rb = rb;
+    if (mpeg) psp_write32(mpeg, data ? data : 0x08000000u);
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+static uint32_t read_be32(uint32_t addr) {
+    return ((uint32_t)psp_read8(addr + 0) << 24) |
+           ((uint32_t)psp_read8(addr + 1) << 16) |
+           ((uint32_t)psp_read8(addr + 2) <<  8) |
+           ((uint32_t)psp_read8(addr + 3) <<  0);
+}
+static void hle_MpegQueryStreamOffset(void) {
+    uint32_t buf = psp_arg(1), off_ptr = psp_arg(2);
+    uint32_t off = buf ? read_be32(buf + 0x08u) : 2048u;
+    if (off_ptr) psp_write32(off_ptr, off);
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+static void hle_MpegQueryStreamSize(void) {
+    uint32_t buf = psp_arg(0), sz_ptr = psp_arg(1);
+    uint32_t sz = buf ? read_be32(buf + 0x0Cu) : 0u;
+    if (sz_ptr) psp_write32(sz_ptr, sz);
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+static void hle_MpegRegistStream(void) { psp_ret(1u); }
+static void hle_MpegMallocAvcEsBuf(void) { psp_ret(1u); }
+static void hle_MpegQueryAtracEsSize(void) {
+    uint32_t es = psp_arg(1), out = psp_arg(2);
+    if (es) psp_write32(es, 2048u);
+    if (out) psp_write32(out, 2048u);
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+static void hle_MpegGetAuNoData(void) {
+    if (g_mpeg_rb) {
+        uint32_t total = psp_read32(g_mpeg_rb + 0u);
+        uint32_t avail = psp_read32(g_mpeg_rb + 12u);
+        if (avail < total) {
+            uint32_t add = total - avail;
+            if (add > 16u) add = 16u;
+            psp_write32(g_mpeg_rb + 12u, avail + add);
+            psp_threadman_yield();
+            psp_ret(SCE_KERNEL_ERROR_OK);
+            return;
+        }
+    }
+    psp_threadman_yield();
+    psp_ret(0x80618001u);
+}
+static void hle_MpegAvcDecode(void) {
+    uint32_t init_ptr = psp_arg(4);
+    if (init_ptr) psp_write32(init_ptr, 1u);
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+static void hle_MpegRingbufferAvailableSize(void) {
+    uint32_t rb = psp_arg(0);
+    uint32_t avail = rb ? psp_read32(rb + 12u) : 0u;
+    psp_threadman_yield();
+    psp_ret(avail);
+}
+static void hle_MpegRingbufferPut(void) {
+    uint32_t rb = psp_arg(0);
+    int32_t packets = (int32_t)psp_arg(1);
+    if (!rb || packets <= 0) { psp_ret(0); return; }
+    uint32_t avail = psp_read32(rb + 12u);
+    if ((uint32_t)packets > avail) packets = (int32_t)avail;
+    if (packets <= 0) { psp_ret(0); return; }
+    uint32_t data = psp_read32(rb + 20u);
+    uint32_t cb   = psp_read32(rb + 24u);
+    uint32_t cbp  = psp_read32(rb + 28u);
+    int32_t ret = packets;
+    if (cb) {
+        uint32_t saved_ra = psp_cpu.r[PSP_REG_RA];
+        psp_cpu.r[PSP_REG_A0] = data;
+        psp_cpu.r[PSP_REG_A1] = (uint32_t)packets;
+        psp_cpu.r[PSP_REG_A2] = cbp;
+        psp_dispatch(cb);
+        psp_cpu.r[PSP_REG_RA] = saved_ra;
+        ret = (int32_t)psp_cpu.r[PSP_REG_V0];
+        if (ret < 0) { psp_ret((uint32_t)ret); return; }
+        if ((uint32_t)ret > avail) ret = (int32_t)avail;
+    }
+    if (ret > 0) {
+        psp_write32(rb + 12u, avail - (uint32_t)ret);
+    }
+    psp_threadman_yield();
+    psp_ret((uint32_t)ret);
+}
