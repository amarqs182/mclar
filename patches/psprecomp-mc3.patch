+static void hle_MpegRingbufferPut(void) {
+    uint32_t rb = psp_arg(0);
+    int32_t packets = (int32_t)psp_arg(1);
+    if (!rb || packets <= 0) { psp_ret(0); return; }
+    uint32_t avail = psp_read32(rb + 12u);
+    if ((uint32_t)packets > avail) packets = (int32_t)avail;
+    if (packets <= 0) { psp_ret(0); return; }
+    uint32_t data = psp_read32(rb + 20u);
+    uint32_t cb   = psp_read32(rb + 24u);
+    uint32_t cbp  = psp_read32(rb + 28u);
+    int32_t ret = packets;
+    if (cb) {
+        uint32_t saved_ra = psp_cpu.r[PSP_REG_RA];
+        psp_cpu.r[PSP_REG_A0] = data;
+        psp_cpu.r[PSP_REG_A1] = (uint32_t)packets;
+        psp_cpu.r[PSP_REG_A2] = cbp;
+        psp_dispatch(cb);
+        psp_cpu.r[PSP_REG_RA] = saved_ra;
+        ret = (int32_t)psp_cpu.r[PSP_REG_V0];
+    }
+    if (ret > 0) {
+        uint32_t written = psp_read32(rb + 8u) + (uint32_t)ret;
+        psp_write32(rb + 8u, written);
+        psp_write32(rb + 12u, (avail > (uint32_t)ret) ? (avail - (uint32_t)ret) : 0u);
+    }
+    if (getenv("PSPRECOMP_TRACE_IO")) {
+        static int put_cnt;
+        if (put_cnt++ < 10 || ret <= 0)
+            fprintf(stderr, "mpeg_put: packets=%d ret=%d avail=%u written=%u\n",
+                    packets, ret, psp_read32(rb + 12u), psp_read32(rb + 8u));
+    }
+    psp_ret((uint32_t)ret);
+}
