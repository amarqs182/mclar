+
+static void hle_UnlockLwMutex(void) {
+    uint32_t workarea = psp_arg(0);
+    int32_t count = (int32_t)psp_arg(1);
+    psp_lwmutex *m = find_lwmutex(workarea);
+    if (!m) { psp_ret(SCE_KERNEL_ERROR_OK); return; }
+    if (count <= 0) count = 1;
+    m->count -= count;
+    if (m->count <= 0) {
+        m->count = 0;
+        m->owner_uid = 0;
+        wake_waiters(W_SEMA);
+    }
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
