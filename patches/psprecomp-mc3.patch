+#include "mpeg_ffmpeg.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "psprecomp/mem.h"
+
+#if PSPRECOMP_HAVE_FFMPEG
+
+#include <libavcodec/avcodec.h>
+#include <libavutil/avutil.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/imgutils.h>
+#include <libswscale/swscale.h>
+
+#define PSP_MPEG_WIDTH        480
+#define PSP_MPEG_HEIGHT       272
+#define PSP_MPEG_AUDIO_SAMPS  2048
+
+typedef struct {
+    uint8_t *data;
+    size_t   len;
+    size_t   cap;
+} byte_buf_t;
+
+static byte_buf_t g_ps_buf       = {0};
+static byte_buf_t g_es_buf       = {0};
+static byte_buf_t g_audio_es_buf = {0};
+
+static AVCodecContext       *g_codec_ctx = NULL;
+static AVCodecParserContext *g_parser    = NULL;
+static AVPacket             *g_pkt       = NULL;
+static AVFrame              *g_frame     = NULL;
+static struct SwsContext    *g_sws_ctx   = NULL;
+static uint8_t               g_rgba_buf[PSP_MPEG_WIDTH * PSP_MPEG_HEIGHT * 4];
+static int                   g_video_flushing = 0;
+
+static AVCodecContext       *g_audio_ctx         = NULL;
+static AVPacket             *g_audio_pkt         = NULL;
+static AVFrame              *g_audio_frame       = NULL;
+static int                   g_audio_block_align = 0;
+static int16_t               g_pcm_buf[PSP_MPEG_AUDIO_SAMPS * 2];
+
+static int buf_append(byte_buf_t *b, const uint8_t *src, size_t n) {
+    if (n == 0) return 0;
+    if (b->len + n > b->cap) {
+        size_t new_cap = b->cap ? b->cap * 2 : 65536;
+        while (new_cap < b->len + n) new_cap *= 2;
+        uint8_t *p = (uint8_t *)realloc(b->data, new_cap);
+        if (!p) return -1;
+        b->data = p;
+        b->cap  = new_cap;
+    }
+    memcpy(b->data + b->len, src, n);
+    b->len += n;
+    return 0;
+}
+
+static void buf_consume(byte_buf_t *b, size_t n) {
+    if (n == 0) return;
+    if (n >= b->len) {
+        b->len = 0;
+        return;
+    }
+    memmove(b->data, b->data + n, b->len - n);
+    b->len -= n;
+}
+
+static uint16_t be16(const uint8_t *p) {
+    return (uint16_t)(((uint16_t)p[0] << 8) | (uint16_t)p[1]);
+}
+
+/* Demux complete MPEG-PS packs/PES packets from g_ps_buf, appending
+ * 0xE0..0xEF video PES payloads into g_es_buf. */
+static void demux_ps_to_es(void) {
+    size_t pos = 0;
+    const uint8_t *d = g_ps_buf.data;
+    size_t len = g_ps_buf.len;
+
+    while (pos + 4 <= len) {
+        if (d[pos] != 0x00 || d[pos + 1] != 0x00 || d[pos + 2] != 0x01) {
+            pos++;
+            continue;
+        }
+
+        uint8_t sid = d[pos + 3];
+
+        if (sid == 0xB9) {
+            /* MPEG program end code */
+            pos += 4;
+            continue;
+        }
+
+        if (sid == 0xBA) {
+            /* Pack header */
+            if (pos + 5 > len) break;
+            if ((d[pos + 4] & 0xC0) == 0x40) {
+                /* MPEG-2 pack header: 14 bytes + stuffing length */
+                if (pos + 14 > len) break;
+                size_t stuff = (size_t)(d[pos + 13] & 0x07);
+                if (pos + 14 + stuff > len) break;
+                pos += 14 + stuff;
+            } else if ((d[pos + 4] & 0xF0) == 0x20) {
+                /* MPEG-1 pack header: 12 bytes */
+                if (pos + 12 > len) break;
+                pos += 12;
+            } else {
+                pos += 4;
+            }
+            continue;
+        }
+
+        if (sid < 0xBB) {
+            /* Video/slice start code outside PES, resync */
+            pos += 4;
+            continue;
+        }
+
+        /* All other system/PES packets (0xBB..0xFF) have a 2-byte length at +4 */
+        if (pos + 6 > len) break;
+        uint16_t pkt_len = be16(d + pos + 4);
+        size_t total = 6u + (size_t)pkt_len;
+
+        if (pkt_len == 0) {
+            /* Unbounded PES packet: scan for next 00 00 01 <>=0xB9> start code */
+            size_t next = pos + 6;
+            int found = 0;
+            while (next + 4 <= len) {
+                if (d[next] == 0x00 && d[next + 1] == 0x00 &&
+                    d[next + 2] == 0x01 && d[next + 3] >= 0xB9) {
+                    found = 1;
+                    break;
+                }
+                next++;
+            }
+            if (!found) break;
+            total = next - pos;
+        } else {
+            if (pos + total > len) break;
+        }
+
+        if ((sid == 0xBD || (sid >= 0xE0 && sid <= 0xEF)) && total > 6) {
+            const uint8_t *pes = d + pos;
+            size_t hdr_end = 6;
+            if (total >= 9 && (pes[6] & 0xC0) == 0x80) {
+                /* MPEG-2 PES header */
+                hdr_end = 9u + (size_t)pes[8];
+            } else {
+                /* MPEG-1 PES header fallback */
+                while (hdr_end < total && pes[hdr_end] == 0xFF) hdr_end++;
+                if (hdr_end < total && (pes[hdr_end] & 0xC0) == 0x40) hdr_end += 2;
+                if (hdr_end < total) {
+                    uint8_t pts_bits = pes[hdr_end] & 0xF0;
+                    if (pts_bits == 0x20)      hdr_end += 5;
+                    else if (pts_bits == 0x30) hdr_end += 10;
+                    else                       hdr_end += 1;
+                }
+            }
+            if (sid == 0xBD) {
+                /* PSP private stream 1: 4-byte substream header (0x00..0x0F = ATRAC3+) */
+                if (hdr_end + 4 < total && (pes[hdr_end] & 0xF0) == 0x00) {
+                    buf_append(&g_audio_es_buf, pes + hdr_end + 4, total - (hdr_end + 4));
+                }
+            } else if (hdr_end < total) {
+                buf_append(&g_es_buf, pes + hdr_end, total - hdr_end);
+            }
+        }
+
+        pos += total;
+    }
+
+    buf_consume(&g_ps_buf, pos);
+}
+
+static int ensure_decoder_init(void) {
+    if (!g_codec_ctx) {
+        av_log_set_level(AV_LOG_ERROR);
+        const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_H264);
+        if (!codec) return -1;
+        g_codec_ctx = avcodec_alloc_context3(codec);
+        if (!g_codec_ctx) return -1;
+        if (avcodec_open2(g_codec_ctx, codec, NULL) < 0) {
+            avcodec_free_context(&g_codec_ctx);
+            return -1;
+        }
+    }
+    if (!g_parser) {
+        g_parser = av_parser_init(AV_CODEC_ID_H264);
+        if (!g_parser) return -1;
+    }
+    if (!g_pkt) {
+        g_pkt = av_packet_alloc();
+        if (!g_pkt) return -1;
+    }
+    if (!g_frame) {
+        g_frame = av_frame_alloc();
+        if (!g_frame) return -1;
+    }
+    return 0;
+}
+
+static int write_decoded_frame(uint32_t guest_buf, int frame_width) {
+    if (g_frame->width <= 0 || g_frame->height <= 0) return -1;
+
+    g_sws_ctx = sws_getCachedContext(
+        g_sws_ctx,
+        g_frame->width, g_frame->height, (enum AVPixelFormat)g_frame->format,
+        PSP_MPEG_WIDTH, PSP_MPEG_HEIGHT, AV_PIX_FMT_RGBA,
+        SWS_BILINEAR, NULL, NULL, NULL);
+    if (!g_sws_ctx) return -1;
+
+    uint8_t *dst_slices[1] = { g_rgba_buf };
+    int      dst_strides[1] = { PSP_MPEG_WIDTH * 4 };
+    sws_scale(g_sws_ctx,
+              (const uint8_t * const *)g_frame->data,
+              g_frame->linesize,
+              0,
+              g_frame->height,
+              dst_slices,
+              dst_strides);
+
+    if (!guest_buf) return 1;
+
+    if (frame_width <= 0) frame_width = 512;
+    uint32_t row_bytes    = PSP_MPEG_WIDTH * 4u;
+    uint32_t stride_bytes = (uint32_t)frame_width * 4u;
+
+    for (int y = 0; y < PSP_MPEG_HEIGHT; y++) {
+        if (psp_mem_write_block(guest_buf + (uint32_t)y * stride_bytes,
+                                g_rgba_buf + (size_t)y * row_bytes,
+                                row_bytes) != 0) {
+            return -1;
+        }
+    }
+    return 1;
+}
+
+void psp_mpeg_reset(void) {
+    g_ps_buf.len = 0;
+    g_es_buf.len = 0;
+    g_audio_es_buf.len = 0;
+    g_video_flushing = 0;
+    if (g_codec_ctx) {
+        avcodec_flush_buffers(g_codec_ctx);
+    }
+    if (g_parser) {
+        av_parser_close(g_parser);
+        g_parser = NULL;
+    }
+    if (g_audio_ctx) {
+        avcodec_free_context(&g_audio_ctx);
+        g_audio_block_align = 0;
+    }
+}
+
+void psp_mpeg_feed_ps(const uint8_t *data, int bytes) {
+    if (!data || bytes <= 0) return;
+    if (buf_append(&g_ps_buf, data, (size_t)bytes) == 0) {
+        demux_ps_to_es();
+    }
+}
+
+int psp_mpeg_decode_next_frame(uint32_t guest_buf, int frame_width) {
+    if (ensure_decoder_init() != 0) return -1;
+
+    /* Check if a frame is already buffered in the decoder. */
+    int ret = avcodec_receive_frame(g_codec_ctx, g_frame);
+    if (ret == 0) {
+        return write_decoded_frame(guest_buf, frame_width);
+    }
+    if (ret == AVERROR_EOF) {
+        g_video_flushing = 0;
+        return 0;
+    }
+    if (ret != AVERROR(EAGAIN)) {
+        return -1;
+    }
+    if (g_video_flushing) {
+        return 0;
+    }
+
+    while (g_es_buf.len > 0) {
+        uint8_t *out_data = NULL;
+        int      out_size = 0;
+        int consumed = av_parser_parse2(
+            g_parser, g_codec_ctx,
+            &out_data, &out_size,
+            g_es_buf.data, (int)g_es_buf.len,
+            AV_NOPTS_VALUE, AV_NOPTS_VALUE, 0);
+        if (consumed < 0) return -1;
+
+        if (out_size > 0 && out_data) {
+            g_pkt->data = out_data;
+            g_pkt->size = out_size;
+            ret = avcodec_send_packet(g_codec_ctx, g_pkt);
+            if (ret == AVERROR(EAGAIN)) {
+                /* Drain a decoded frame first, then retry sending the same packet. */
+                int r2 = avcodec_receive_frame(g_codec_ctx, g_frame);
+                if (r2 == 0) {
+                    int s2 = avcodec_send_packet(g_codec_ctx, g_pkt);
+                    g_pkt->data = NULL;
+                    g_pkt->size = 0;
+                    if (s2 >= 0) {
+                        buf_consume(&g_es_buf, (size_t)consumed);
+                    }
+                    return write_decoded_frame(guest_buf, frame_width);
+                }
+                g_pkt->data = NULL;
+                g_pkt->size = 0;
+                if (r2 != AVERROR(EAGAIN) && r2 != AVERROR_EOF) {
+                    return -1;
+                }
+                continue;
+            }
+            g_pkt->data = NULL;
+            g_pkt->size = 0;
+
+            if (ret >= 0) {
+                buf_consume(&g_es_buf, (size_t)consumed);
+            } else if (ret == AVERROR_INVALIDDATA) {
+                buf_consume(&g_es_buf, (size_t)consumed);
+                continue;
+            } else {
+                return -1;
+            }
+
+            ret = avcodec_receive_frame(g_codec_ctx, g_frame);
+            if (ret == 0) {
+                return write_decoded_frame(guest_buf, frame_width);
+            }
+            if (ret != AVERROR(EAGAIN) && ret != AVERROR_EOF) {
+                return -1;
+            }
+        } else {
+            buf_consume(&g_es_buf, (size_t)consumed);
+        }
+    }
+
+    return 0;
+}
+
+static int ensure_audio_decoder_init(int block_align) {
+    av_log_set_level(AV_LOG_ERROR);
+    if (g_audio_ctx && g_audio_block_align != block_align) {
+        avcodec_free_context(&g_audio_ctx);
+        g_audio_block_align = 0;
+    }
+    if (!g_audio_ctx) {
+        const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_ATRAC3P);
+        if (!codec) return -1;
+        g_audio_ctx = avcodec_alloc_context3(codec);
+        if (!g_audio_ctx) return -1;
+        av_channel_layout_default(&g_audio_ctx->ch_layout, 2);
+        g_audio_ctx->sample_rate = 44100;
+        g_audio_ctx->block_align = block_align;
+        if (avcodec_open2(g_audio_ctx, codec, NULL) < 0) {
+            avcodec_free_context(&g_audio_ctx);
+            return -1;
+        }
+        g_audio_block_align = block_align;
+    }
+    if (!g_audio_pkt) {
+        g_audio_pkt = av_packet_alloc();
+        if (!g_audio_pkt) return -1;
+    }
+    if (!g_audio_frame) {
+        g_audio_frame = av_frame_alloc();
+        if (!g_audio_frame) return -1;
+    }
+    return 0;
+}
+
+static int16_t float_to_s16(float v) {
+    float scaled = v * 32767.0f;
+    if (scaled >= 32767.0f) return 32767;
+    if (scaled <= -32768.0f) return -32768;
+    return (int16_t)scaled;
+}
+
+int psp_mpeg_decode_audio_frame(uint32_t guest_pcm_buf) {
+    while (g_audio_es_buf.len >= 8) {
+        if (g_audio_es_buf.data[0] != 0x0F || g_audio_es_buf.data[1] != 0xD0) {
+            size_t skip = 1;
+            while (skip + 1 < g_audio_es_buf.len &&
+                   (g_audio_es_buf.data[skip] != 0x0F || g_audio_es_buf.data[skip + 1] != 0xD0)) {
+                skip++;
+            }
+            buf_consume(&g_audio_es_buf, skip);
+            continue;
+        }
+
+        int payload_sz = ((((int)(g_audio_es_buf.data[2] & 0x03) << 8) |
+                           (int)g_audio_es_buf.data[3]) + 1) * 8;
+        int frame_sz = 8 + payload_sz;
+        if (g_audio_es_buf.len < (size_t)frame_sz) {
+            return 0;
+        }
+
+        if (ensure_audio_decoder_init(payload_sz) != 0) {
+            return -1;
+        }
+
+        g_audio_pkt->data = g_audio_es_buf.data + 8;
+        g_audio_pkt->size = payload_sz;
+        int ret = avcodec_send_packet(g_audio_ctx, g_audio_pkt);
+        g_audio_pkt->data = NULL;
+        g_audio_pkt->size = 0;
+        buf_consume(&g_audio_es_buf, (size_t)frame_sz);
+
+        if (ret < 0 && ret != AVERROR(EAGAIN)) {
+            if (ret == AVERROR_INVALIDDATA) continue;
+            return -1;
+        }
+
+        ret = avcodec_receive_frame(g_audio_ctx, g_audio_frame);
+        if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) {
+            continue;
+        }
+        if (ret < 0) {
+            return -1;
+        }
+
+        int n = g_audio_frame->nb_samples;
+        if (n > PSP_MPEG_AUDIO_SAMPS) n = PSP_MPEG_AUDIO_SAMPS;
+        memset(g_pcm_buf, 0, sizeof(g_pcm_buf));
+
+        if (g_audio_frame->format == AV_SAMPLE_FMT_FLTP) {
+            const float *l = (const float *)g_audio_frame->data[0];
+            const float *r = (g_audio_frame->ch_layout.nb_channels > 1 && g_audio_frame->data[1])
+                                 ? (const float *)g_audio_frame->data[1]
+                                 : l;
+            for (int i = 0; i < n; i++) {
+                g_pcm_buf[i * 2 + 0] = float_to_s16(l[i]);
+                g_pcm_buf[i * 2 + 1] = float_to_s16(r[i]);
