+    int64_t y = (int64_t)year - (month <= 2);
+    int64_t era = (y >= 0 ? y : y - 399) / 400;
+    uint64_t yoe = (uint64_t)(y - era * 400);
+    uint64_t doy = (153u * (uint32_t)(month + (month > 2 ? -3 : 9)) + 2u) / 5u + day - 1u;
+    uint64_t doe = yoe * 365u + yoe / 4u - yoe / 100u + doy;
+    int64_t days = era * 146097 + (int64_t)doe - 719468;
+    int64_t secs = days * 86400 + (int64_t)hour * 3600 + (int64_t)minute * 60 + (int64_t)second;
+    uint64_t ft = ((uint64_t)(secs + 11644473600LL)) * 10000000ULL + (uint64_t)usec * 10ULL;
+    psp_write32(out_ptr, (uint32_t)ft);
+    psp_write32(out_ptr + 4, (uint32_t)(ft >> 32));
+    psp_ret(SCE_KERNEL_ERROR_OK);
