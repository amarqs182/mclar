+#ifndef PSPRECOMP_MPEG_FFMPEG_H
+#define PSPRECOMP_MPEG_FFMPEG_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Reset demuxer and decoder state (e.g., on sceMpegCreate / Delete / Flush). */
+void psp_mpeg_reset(void);
+
+/* Feed raw MPEG-PS (PSMF) bytes from the ringbuffer into the demuxer. */
+void psp_mpeg_feed_ps(const uint8_t *data, int bytes);
+
+/* Decode the next H.264 video frame to 480x272 RGBA and write rows to guest_buf
+ * at stride frame_width * 4 via psp_mem_write_block.
+ * Returns 1 if a frame was decoded, 0 if more data is needed, -1 on error. */
+int psp_mpeg_decode_next_frame(uint32_t guest_buf, int frame_width);
+
+/* Decode the next ATRAC3+ audio frame to 44100 Hz stereo S16LE (2048 samples =
+ * 8192 bytes) and write to guest_pcm_buf via psp_mem_write_block.
+ * Returns 1 if a frame was decoded, 0 if more data is needed, -1 on error. */
+int psp_mpeg_decode_audio_frame(uint32_t guest_pcm_buf);
+
+/* Return the number of elementary stream (H.264 ES) bytes currently buffered. */
+int psp_mpeg_buffered_es_bytes(void);
+
+/* Return the number of ATRAC3+ audio ES bytes currently buffered. */
+int psp_mpeg_buffered_audio_bytes(void);
+
+/* Return 1 if video ES or flushed decoder frames remain pending, 0 otherwise. */
+int psp_mpeg_has_pending_video(void);
+
+/* Flush the H.264 parser and send EOS to the video decoder so trailing frames drain. */
+void psp_mpeg_flush_video(void);
+
+/* Return 1 if at least one complete 0x0F 0xD0 ATRAC3+ frame is buffered, 0 otherwise. */
+int psp_mpeg_has_pending_audio(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSPRECOMP_MPEG_FFMPEG_H */
