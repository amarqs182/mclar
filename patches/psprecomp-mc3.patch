diff --git c/src/hle/umd.c w/src/hle/umd.c
new file mode 100644
index 0000000..fc217a6
--- /dev/null
+++ w/src/hle/umd.c
@@ -0,0 +1,87 @@
+/* psprecomp — sceUmdUser: the UMD drive.
+ *
+ * The PSP's optical drive. A game asks two things of it before it reads
+ * anything: "is there a disc in there?" (sceUmdActivate) and "what is the
+ * drive doing right now?" (sceUmdWaitDriveStat).
+ *
+ * There is no drive here. The host serves the game from a directory instead,
+ * so the honest answer to both questions is "no disc" — but the *shape* of the
+ * answer matters, because the game reads the return value and branches on it.
+ *
+ *   sceUmdActivate(driver, slot) returns 1 when a disc is present and 0 when
+ *   the bay is empty. Returning 0 tells the game there is nothing to read,
+ *   which is a normal, handled state: games check it and show "insert disc".
+ *   Returning 1 would tell the game to go read a disc that is not there.
+ *
+ *   sceUmdWaitDriveStat(slot) blocks until the drive finishes its current
+ *   operation and then reports the drive state. The state values are the
+ *   SceUmdDriveStat enum; the one that matters here is "not inserted".
+ *
+ * Both of those are a "there is no disc" answer, which is a complete answer
+ * rather than a stub: nothing in the guest can make a disc appear. What would
+ * not be complete is returning 0 from Activate and letting the game proceed
+ * as if the disc were there — that is the failure mode where the game reads
+ * garbage and crashes later, far from the cause.
+ */
+
+#include "psprecomp/hle.h"
+
+/* Drive states, from pspumd.h (SceUmdDriveStat). */
+#define PSP_UMD_NOT_PRESENT 0x01
+#define PSP_UMD_PRESENT     0x02
+#define PSP_UMD_READY       0x10
+#define PSP_UMD_READABLE    0x20
+#define UMD_STAT_MOUNTED    (PSP_UMD_PRESENT | PSP_UMD_READY | PSP_UMD_READABLE)
+
+/* sceUmdActivate returns 0 (SCE_KERNEL_ERROR_OK) on success. */
+static void hle_UmdActivate(void) {
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+/* sceUmdWaitDriveStat reports the drive state. */
+static void hle_UmdWaitDriveStat(void) {
+    psp_ret(UMD_STAT_MOUNTED);
+}
+
+/* sceUmdRegisterUMDCallBack registers the "disc inserted" callback. */
+static void hle_UmdRegisterUMDCallBack(void) {
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_UmdUnRegisterUMDCallBack(void) {
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+/* sceUmdCheckMedium returns 1 when a UMD disc is present. */
+static void hle_UmdCheckMedium(void) {
+    psp_ret(1);
+}
+
+static void hle_UmdDeactivate(void) {
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_UmdGetDriveStat(void) {
+    psp_ret(UMD_STAT_MOUNTED);
+}
+
+static void hle_UmdGetErrorStat(void) {
+    /* (slot) */
+    psp_ret(0);
+}
+
+void psp_umd_init(void) { }
+
+void psp_umd_register(void) {
+    /* NIDs are SHA-1(name)[0:4] little-endian; see tools/nid_lookup.py and
+     * the PPSSPP-derived NID list for how each was resolved. */
+    psp_hle_register(0xC6183D47, "sceUmdUser", "sceUmdActivate",             hle_UmdActivate);
+    psp_hle_register(0x8EF08FCE, "sceUmdUser", "sceUmdWaitDriveStat",        hle_UmdWaitDriveStat);
+    psp_hle_register(0x4A9E5E29, "sceUmdUser", "sceUmdWaitDriveStatCB",      hle_UmdWaitDriveStat);
+    psp_hle_register(0xAEE7404D, "sceUmdUser", "sceUmdRegisterUMDCallBack",  hle_UmdRegisterUMDCallBack);
+    psp_hle_register(0xBD2BDE07, "sceUmdUser", "sceUmdUnRegisterUMDCallBack",hle_UmdUnRegisterUMDCallBack);
+    psp_hle_register(0x46EBB729, "sceUmdUser", "sceUmdCheckMedium",          hle_UmdCheckMedium);
+    psp_hle_register(0xE83742BA, "sceUmdUser", "sceUmdDeactivate",           hle_UmdDeactivate);
+    psp_hle_register(0x6B4A146C, "sceUmdUser", "sceUmdGetDriveStat",         hle_UmdGetDriveStat);
+    psp_hle_register(0x20628E6F, "sceUmdUser", "sceUmdGetErrorStat",         hle_UmdGetErrorStat);
+}
diff --git c/src/mem.c w/src/mem.c
index 99da3ec..5464208 100644
--- c/src/mem.c
+++ w/src/mem.c
@@ -125,8 +125,11 @@ void *psp_mem_ptr(uint32_t addr, uint32_t size) {
         if (off + size > PSP_RAM_SIZE) return NULL;   /* straddles the end */
         return psp_mem.ram + off;
     }
-    if (a >= PSP_VRAM_BASE && a < PSP_VRAM_BASE + PSP_VRAM_SIZE) {
-        uint32_t off = a - PSP_VRAM_BASE;
+    /* PSP EDRAM is 2 MB (0x04000000-0x041FFFFF) mirrored 4x across 8 MB
+     * (0x04000000-0x047FFFFF); games use upper mirrors (e.g. 0x04710000)
+     * for unswizzled / direct EDRAM access. */
+    if (a >= PSP_VRAM_BASE && a < PSP_VRAM_BASE + 0x00800000u) {
+        uint32_t off = (a - PSP_VRAM_BASE) & (PSP_VRAM_SIZE - 1u);
         if (off + size > PSP_VRAM_SIZE) return NULL;
         return psp_mem.vram + off;
     }
