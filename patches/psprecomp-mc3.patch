+/* ---- sceAtrac3plus ------------------------------------------------------- */
+#define MAX_ATRAC 8
+typedef struct {
+    int used;
+    uint32_t buf_addr;
+    uint32_t buf_size;
+    int channels;
+    int loop_num;
+    int remain_frames;
+} atrac_slot;
+static atrac_slot g_atrac[MAX_ATRAC];
+
+static atrac_slot *atrac_get(int32_t id) {
+    if (id < 0 || id >= MAX_ATRAC || !g_atrac[id].used) return NULL;
+    return &g_atrac[id];
+}
+
+static void hle_AtracSetDataAndGetID(void) {
+    uint32_t buf  = psp_arg(0);
+    uint32_t size = psp_arg(1);
+    for (int i = 0; i < MAX_ATRAC; i++) {
+        if (g_atrac[i].used) continue;
+        g_atrac[i].used = 1;
+        g_atrac[i].buf_addr = buf;
+        g_atrac[i].buf_size = size;
+        g_atrac[i].channels = 2;
+        if (buf && size >= 24 && psp_read32(buf) == 0x46464952u) {
+            uint16_t ch = psp_read16(buf + 22);
+            if (ch == 1 || ch == 2) g_atrac[i].channels = (int)ch;
+        }
+        g_atrac[i].loop_num = 0;
+        g_atrac[i].remain_frames = 600;
+        psp_ret((uint32_t)i);
+        return;
+    }
+    psp_ret(0x80630003u);
+}
+
+static void hle_AtracReleaseAtracID(void) {
+    atrac_slot *s = atrac_get((int32_t)psp_arg(0));
+    if (!s) { psp_ret(0x80630004u); return; }
+    s->used = 0;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_AtracDecodeData(void) {
+    atrac_slot *s = atrac_get((int32_t)psp_arg(0));
+    if (!s) { psp_ret(0x80630004u); return; }
+    uint32_t out_samples = psp_arg(1);
+    uint32_t out_n       = psp_arg(2);
+    uint32_t out_end     = psp_arg(3);
+    uint32_t out_remain  = psp_arg(4);
+    const uint32_t nsamples = 1024u;
+    if (out_samples) {
+        uint32_t bytes = nsamples * (uint32_t)s->channels * 2u;
+        void *dst = psp_mem_ptr(out_samples, bytes);
+        if (dst) memset(dst, 0, bytes);
+    }
+    int ended = 0;
+    if (s->loop_num == 0) {
+        if (s->remain_frames > 0) s->remain_frames--;
+        if (s->remain_frames <= 0) ended = 1;
+    }
+    if (out_n)      psp_write32(out_n, nsamples);
+    if (out_end)    psp_write32(out_end, (uint32_t)ended);
+    if (out_remain) psp_write32(out_remain, ended ? 0u : (uint32_t)-1);
+    psp_threadman_yield();
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+
+static void hle_AtracGetRemainFrame(void) {
+    atrac_slot *s = atrac_get((int32_t)psp_arg(0));
+    uint32_t out_remain = psp_arg(1);
+    if (!s) { psp_ret(0x80630004u); return; }
+    if (out_remain) psp_write32(out_remain, (uint32_t)s->remain_frames);
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
